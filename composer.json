{
    "name": "meits/converter",
    "description": "A small hand-rolled front controller built on standalone Symfony components (routing, DI, HTTP kernel) and Doctrine ORM.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Viktor Gavrilenko",
            "email": "meitslin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/config": "^7.1",
        "symfony/dependency-injection": "^7.1",
        "symfony/error-handler": "^7.1",
        "symfony/event-dispatcher": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/http-kernel": "^7.1",
        "symfony/routing": "^7.1",
        "symfony/yaml": "^7.1",
        "doctrine/orm": "^3.3",
        "symfony/cache": "^7.1",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "symfony/var-dumper": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8000 -t public",
        "db:init": "php bin/init-db.php",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
